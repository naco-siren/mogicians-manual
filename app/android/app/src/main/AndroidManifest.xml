<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Media playback foreground service (audio_service). -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>

    <application
        android:label="膜法指南"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- audio_service: the media session / foreground service that keeps
             music playing when the app is not visible, plus its media button
             receiver. -->
        <service android:name="com.ryanheise.audioservice.AudioService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true" tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
        <receiver android:name="com.ryanheise.audioservice.MediaButtonReceiver"
            android:exported="true" tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>
        <!-- Serves this app's own installed APK to the share sheet
             ("分享安装包"), read-only and only through per-intent URI grants. -->
        <provider
            android:name=".ApkProvider"
            android:authorities="${applicationId}.apk"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
    <!-- Package visibility (Android 11+). Without these entries the queries
         made by the Flutter engine and by url_launcher's canLaunchUrl() come
         back empty. See https://developer.android.com/training/package-visibility -->
    <queries>
        <!-- Used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Web links (GitHub, the developer's site) opened from the app bar. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <category android:name="android.intent.category.BROWSABLE"/>
            <data android:scheme="https"/>
        </intent>
        <!-- "分享安装包": which apps would take the installer from the share
             sheet, and which phone-to-phone transfer apps are installed
             (keep in sync with ShareApps.kt). -->
        <intent>
            <action android:name="android.intent.action.SEND"/>
            <data android:mimeType="*/*"/>
        </intent>
        <package android:name="com.miui.mishare.connectivity"/>
        <package android:name="com.coloros.oshare"/>
        <package android:name="com.oneplus.oshare"/>
        <package android:name="com.vivo.easyshare"/>
        <package android:name="com.hihonor.android.instantshare"/>
        <package android:name="com.huawei.android.instantshare"/>
        <package android:name="com.samsung.android.app.sharelive"/>
        <package android:name="com.samsung.android.aware.service"/>
        <package android:name="com.google.android.apps.nbu.files"/>
        <package android:name="com.xiaomi.midrop"/>
        <package android:name="org.localsend.localsend_app"/>
        <package android:name="moe.reimu.catshare"/>
        <package android:name="com.dewmobile.kuaiya"/>
        <package android:name="com.dewmobile.kuaiya.play"/>
        <package android:name="com.lenovo.anyshare"/>
        <package android:name="com.lenovo.anyshare.gps"/>
        <package android:name="cn.xender"/>
    </queries>
</manifest>
